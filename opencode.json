{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "model": "insurance-gateway/sonnet-4-6",
  "providers": {
    "insurance-gateway": {
      "name": "Insurance guardrail gateway (LiteLLM -> Bedrock)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "sonnet-4-6": {
          "name": "Claude Sonnet 4.6 on Bedrock (via guardrail gateway)"
        }
      }
    }
  },
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "insurance-gateway",
      "effect": "allow"
    }
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*sample_app/*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*tests/*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*docs/*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*tests/security/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pytest*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python -m pytest*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ruff check*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git add*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pip install*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git remote*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -r *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "aws *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "ssh*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "scp*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "chmod 777*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*.env*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
